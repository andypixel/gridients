# Copy to .env for local dev. In production set these in Railway's
# service Variables tab — never commit real values.

ANTHROPIC_API_KEY=sk-ant-...

# Shared password for the login screen.
APP_PASSWORD=pick-something-long

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_OUTPUT_TOKENS=8000
DAILY_CALL_LIMIT=300
PORT=3000

# Local dev is plain http, so the session cookie can't be Secure.
# Leave this UNSET in production.
COOKIE_SECURE=false
