# Copy to .env for local dev. In production set these in Railway's
# service Variables tab — never commit real values.

# Required unless ANTHROPIC_AUTH_MODE=oauth (see below).
ANTHROPIC_API_KEY=sk-ant-...

# Shared password for the login screen.
APP_PASSWORD=pick-something-long

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_OUTPUT_TOKENS=8000
DAILY_CALL_LIMIT=300
PORT=3000

# Local dev only: set to "oauth" to authenticate Anthropic calls through your
# Claude subscription (via the `ant` CLI — run `ant auth login` first)
# instead of ANTHROPIC_API_KEY, so dev/testing usage draws from your personal
# plan instead of the production key. Leave UNSET in production — Railway
# always authenticates with ANTHROPIC_API_KEY.
ANTHROPIC_AUTH_MODE=

# Local dev is plain http, so the session cookie can't be Secure.
# Leave this UNSET in production.
COOKIE_SECURE=false
